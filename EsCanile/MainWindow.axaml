
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EsCanile.MainWindow"
        Title="EsCanile"
        Width="900"
        Height="700"
        Background="White">

    <Grid ColumnDefinitions="*,*" Margin="10" ColumnSpacing="15">

        <StackPanel Grid.Column="0" Spacing="10">

            <TextBlock Text="REGISTRA UN NUOVO CANE"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="Nome cane"/>

            <TextBox x:Name="txtNome"
                     PlaceholderText="Inserisci nome cane"/>

            <TextBlock Text="Anno di nascita"/>

            <TextBox x:Name="txtAnnoNascita"
                     PlaceholderText="Inserisci anno di nascita"/>

            <TextBlock Text="Razza"/>

            <ComboBox x:Name="cmbRazza"/>

            <TextBlock Text="Data di ingresso"/>

            <DatePicker x:Name="dataIngresso"/>

            <TextBlock Text="Stato del cane"/>

            <ComboBox x:Name="cmbStato"/>

            <TextBlock Text="Informazioni per l'adozione"/>

            <TextBox x:Name="txtInformazioni"
                     PlaceholderText="Inserisci informazioni..."
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>

            <Button Content="AGGIUNGI CANE"
                    Click="AggiungiCane_Click"/>

            <Button Content="PULISCI CAMPI"
                    Click="PulisciCampi_Click"/>

            <TextBlock x:Name="txtMessaggio"
                       Text="Inserisci i dati del cane."
                       TextWrapping="Wrap"/>

        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10">

            <TextBlock Text="CANI PRESENTI"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtRicerca"
                     PlaceholderText="Cerca cane per nome..."
                     TextChanged="CercaCane_TextChanged"/>

            <TextBlock Text="Elenco degli animali nel canile"/>

            <ListBox x:Name="listaCani"
                     Height="450"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <ComboBox x:Name="cmbNuovoStato"/>

            <Button Content="CAMBIA STATO"
                    Click="CambiaStato_Click"/>

            <Button Content="ADOTTA CANE SELEZIONATO"
                    Click="AdottaCane_Click"/>

            <TextBlock x:Name="txtTotale"
                       Text="Cani presenti: 0"/>

            <TextBlock x:Name="txtAdottati"
                       Text="Cani adottati: 0"/>

        </StackPanel>

    </Grid>

</Window>
